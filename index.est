import { MqttMessage } from '@ohos/mqtt';
import MQTTUtil from '../common/utils/MQTTUtil';

interface ConveyorData {
  hasItem?: number;
  temperature?: number;
  motorState?: number;
}

@Entry
@Component
struct Index {
  @State hasItem: number = 0;
  @State temperature: number = 0.0;
  @State motorState: number = 0;
  @State wifiStatus: number = 0;
  @State lastUpdateTime: string = '--:--:--';
  private mqttUtil: MQTTUtil = new MQTTUtil();

  aboutToAppear(): void {
    // Initialize mock data
    this.initMockData();

    // Connect to MQTT to receive real-time data
    // WiFi SSID: zys, Password: 12345678
    // MQTT Broker: 192.168.43.230:1883
    this.mqttUtil.connect(
      (err: Error, data: MqttMessage) => {
        if (!err && data?.payload) {
          try {
            const receivedData: ConveyorData = JSON.parse(String(data.payload));
            
            // Update conveyor data
            this.hasItem = receivedData.hasItem ?? this.hasItem;
            this.temperature = receivedData.temperature ?? this.temperature;
            this.motorState = receivedData.motorState ?? this.motorState;
            
            this.wifiStatus = 1; // Data received means connected
            this.lastUpdateTime = new Date().toLocaleTimeString();
          } catch (e) {
            console.error('Failed to parse MQTT data:', e);
          }
        }
      }
    );
  }

  initMockData(): void {
    // Initialize with default values
    this.hasItem = 0;
    this.temperature = 25.0;
    this.motorState = 0;
    this.wifiStatus = 0;
  }

  build() {
    Column() {
      // Title bar
      Row() {
        Image($r('app.media.conveyor'))
          .width(32)
          .height(32)
        Text("智能传送带系统")
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor(Color.White)
          .margin({ left: 10 })
      }
      .width('100%')
      .height(56)
      .padding({ left: 16, right: 16 })
      .backgroundColor('#FF6B35')
      .justifyContent(FlexAlign.Start)

      // Content area
      Scroll() {
        Column({ space: 16 }) {
          // Connection status
          Row() {
            Text('WiFi状态: ')
              .fontSize(16)
              .fontColor('#333333')
            Text(this.wifiStatus === 1 ? '已连接 (zys)' : '未连接')
              .fontSize(16)
              .fontColor(this.wifiStatus === 1 ? '#4CAF50' : '#FF5252')
              .fontWeight(FontWeight.Bold)
            Blank()
            Text('更新: ' + this.lastUpdateTime)
              .fontSize(12)
              .fontColor('#999999')
          }
          .width('90%')
          .padding(16)
          .backgroundColor(Color.White)
          .borderRadius(8)
          .shadow({ radius: 4, color: '#E0E0E0', offsetX: 0, offsetY: 2 })

          // Item detection status
          Column() {
            Row() {
              Text('物品检测')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#333333')
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 12 })

            Row() {
              Column() {
                Image(this.hasItem === 1 ? $r('app.media.item_detected') : $r('app.media.item_none'))
                  .width(64)
                  .height(64)
                  .fillColor(this.hasItem === 1 ? '#FF6B35' : '#BDBDBD')
                Text(this.hasItem === 1 ? '有物品' : '无物品')
                  .fontSize(16)
                  .fontColor(this.hasItem === 1 ? '#FF6B35' : '#757575')
                  .fontWeight(FontWeight.Medium)
                  .margin({ top: 8 })
              }
              .layoutWeight(1)
            }
            .width('100%')
            .justifyContent(FlexAlign.Center)
          }
          .width('90%')
          .padding(20)
          .backgroundColor(Color.White)
          .borderRadius(8)
          .shadow({ radius: 4, color: '#E0E0E0', offsetX: 0, offsetY: 2 })

          // Temperature display
          Column() {
            Row() {
              Text('温度监测')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#333333')
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 12 })

            Row() {
              Column() {
                Text(this.temperature.toFixed(1))
                  .fontSize(48)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(this.temperature > 30 ? '#FF5252' : '#42A5F5')
                Row() {
                  Text('℃')
                    .fontSize(24)
                    .fontColor(this.temperature > 30 ? '#FF5252' : '#42A5F5')
                }
                if (this.temperature > 30) {
                  Text('⚠️ 温度过高')
                    .fontSize(14)
                    .fontColor('#FF5252')
                    .fontWeight(FontWeight.Medium)
                    .margin({ top: 8 })
                }
              }
              .layoutWeight(1)
            }
            .width('100%')
            .justifyContent(FlexAlign.Center)
          }
          .width('90%')
          .padding(20)
          .backgroundColor(Color.White)
          .borderRadius(8)
          .shadow({ radius: 4, color: '#E0E0E0', offsetX: 0, offsetY: 2 })

          // Motor status
          Column() {
            Row() {
              Text('电机状态')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#333333')
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 12 })

            Row() {
              Column() {
                Image(this.motorState === 1 ? $r('app.media.motor_running') : $r('app.media.motor_stop'))
                  .width(64)
                  .height(64)
                  .fillColor(this.motorState === 1 ? '#4CAF50' : '#757575')
                Text(this.motorState === 1 ? '运行中' : '已停止')
                  .fontSize(16)
                  .fontColor(this.motorState === 1 ? '#4CAF50' : '#757575')
                  .fontWeight(FontWeight.Medium)
                  .margin({ top: 8 })
              }
              .layoutWeight(1)
            }
            .width('100%')
            .justifyContent(FlexAlign.Center)
          }
          .width('90%')
          .padding(20)
          .backgroundColor(Color.White)
          .borderRadius(8)
          .shadow({ radius: 4, color: '#E0E0E0', offsetX: 0, offsetY: 2 })

          // System info
          Column() {
            Row() {
              Text('系统信息')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#333333')
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 12 })

            Column({ space: 8 }) {
              Row() {
                Text('WiFi SSID:')
                  .fontSize(14)
                  .fontColor('#666666')
                  .width(100)
                Text('zys')
                  .fontSize(14)
                  .fontColor('#333333')
                  .fontWeight(FontWeight.Medium)
              }
              .width('100%')

              Row() {
                Text('MQTT服务器:')
                  .fontSize(14)
                  .fontColor('#666666')
                  .width(100)
                Text('192.168.43.230:1883')
                  .fontSize(14)
                  .fontColor('#333333')
                  .fontWeight(FontWeight.Medium)
              }
              .width('100%')

              Row() {
                Text('设备ID:')
                  .fontSize(14)
                  .fontColor('#666666')
                  .width(100)
                Text('hi3861_conveyor')
                  .fontSize(14)
                  .fontColor('#333333')
                  .fontWeight(FontWeight.Medium)
              }
              .width('100%')
            }
            .width('100%')
          }
          .width('90%')
          .padding(20)
          .backgroundColor(Color.White)
          .borderRadius(8)
          .shadow({ radius: 4, color: '#E0E0E0', offsetX: 0, offsetY: 2 })
        }
        .padding({ top: 16, bottom: 20 })
      }
      .layoutWeight(1)
      .backgroundColor('#F5F5F5')
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F5F5')
  }
}
